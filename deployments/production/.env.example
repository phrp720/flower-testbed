# Database
DATABASE_URL="postgresql://floweruser:flowerpass@postgres:5432/flowertestbed?schema=public"

# Application
NODE_ENV=production

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=q4FbKOLrloRaGo0AL4Xe34Xyb590wVVBi5WOUxFCU28

# Auth Credentials (single user)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Show flower logs in the console
SHOW_FLWR_LOGS=false

# Postgres Settings
POSTGRES_USER=
POSTGRES_PASSWORD=

# Directories to store checkpoints and uploaded data(set absolute paths)
CHECKPOINTS_DIR=
DATA_DIR=

# Experiment execution backend
EXPERIMENT_EXECUTOR=docker

# Optional cap for concurrent worker containers in production Docker mode.
# Leave empty for unlimited.
MAX_CONCURRENT_EXPERIMENTS=

# Container socket settings for worker spawning.
# Standard Docker daemon:
# HOST_CONTAINER_SOCKET_PATH=/var/run/docker.sock
# CONTAINER_SOCKET_PATH=/var/run/docker.sock
#
# Rootless Podman example:
# HOST_CONTAINER_SOCKET_PATH=/run/user/<uid>/podman/podman.sock
# CONTAINER_SOCKET_PATH=/run/podman-user.sock
HOST_CONTAINER_SOCKET_PATH=/var/run/docker.sock
CONTAINER_SOCKET_PATH=/var/run/docker.sock

# Flower/Ray resource tuning
RAY_NUM_CPUS=8
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
VECLIB_MAXIMUM_THREADS=1

# Image Version
IMAGE_VERSION=latest

VENV_PATH=/opt/venv

# ---------------------------------------------------------------------------
# AI agent layer
# ---------------------------------------------------------------------------

# Encrypts provider API keys at rest (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Falls back to NEXTAUTH_SECRET when unset, but then rotating your auth secret
# also invalidates every stored API key.
AGENT_SECRET_KEY=

# Where the agent may write files. Defaults to <DATA_DIR>/agent-workspace.
AGENT_WORKSPACE_DIR=

# How the in-app agent reaches the MCP server: 'http' (default) or 'inmemory'.
AGENT_MCP_TRANSPORT=http
INTERNAL_BASE_URL=
INTERNAL_MCP_TOKEN=

# Safety rails on the agent loop
AGENT_MAX_ITERATIONS=24
AGENT_MAX_TOOL_RESULT_BYTES=32768

# Allow the agent to edit the application/runner source, not just experiment code.
AGENT_ALLOW_REPO_WRITES=false
