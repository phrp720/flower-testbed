# Database
DATABASE_URL="postgresql://floweruser:flowerpass@localhost:5432/flowertestbed?schema=public"

# Application
NODE_ENV=development

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=q4FbKOLrloRaGo0AL4Xe34Xyb590wVVBi5WOUxFCU28=

# Auth Credentials (single user)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Show flower logs in the console
SHOW_FLWR_LOGS=false

# Directories to store checkpoints and uploaded data(set absolute paths)
CHECKPOINTS_DIR=
DATA_DIR=

# ---------------------------------------------------------------------------
# AI agent layer
# ---------------------------------------------------------------------------

# Encrypts provider API keys at rest (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Falls back to NEXTAUTH_SECRET when unset, but then rotating your auth secret
# also invalidates every stored API key.
AGENT_SECRET_KEY=

# Where the agent may write files. Defaults to <DATA_DIR>/agent-workspace.
# This is the only writable location; nothing else on disk is.
AGENT_WORKSPACE_DIR=

# How the in-app agent reaches the MCP server.
# 'http' (default) goes through /api/mcp, exactly as an external MCP client does.
# 'inmemory' links the client and server directly, skipping the network hop.
AGENT_MCP_TRANSPORT=http

# Where the app can reach itself for the loopback MCP call. Only needed if it is
# not addressable at http://127.0.0.1:$PORT.
INTERNAL_BASE_URL=

# Bearer token the agent uses for its own MCP calls. Left empty, one is
# provisioned automatically at startup and rotated on restart.
INTERNAL_MCP_TOKEN=

# Safety rails on the agent loop
AGENT_MAX_ITERATIONS=24
AGENT_MAX_TOOL_RESULT_BYTES=32768

# Allow the agent to edit the application/runner source, not just experiment code.
# Off by default; this is the widest-blast-radius setting in the system.
AGENT_ALLOW_REPO_WRITES=false
